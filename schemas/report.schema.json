{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-compat-lab.dev/schemas/report.schema.json",
  "title": "Agent Compat Lab Probe Report",
  "type": "object",
  "required": ["checkedAt", "results"],
  "properties": {
    "checkedAt": { "type": "string", "format": "date-time" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent", "name", "cwd", "installed", "repositoryMarkers", "presentMarkerCount"],
        "properties": {
          "agent": { "type": "string" },
          "name": { "type": "string" },
          "cwd": { "type": "string" },
          "installed": { "type": "boolean" },
          "command": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["command", "executable", "version"],
                "additionalProperties": false,
                "properties": {
                  "command": { "type": "string" },
                  "executable": { "type": "string" },
                  "version": {
                    "type": "object",
                    "required": ["ok", "status", "output"],
                    "additionalProperties": false,
                    "properties": {
                      "ok": { "type": "boolean" },
                      "status": { "type": ["integer", "null"] },
                      "output": { "type": ["string", "null"] }
                    }
                  }
                }
              }
            ]
          },
          "repositoryMarkers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "present"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "present": { "type": "boolean" }
              }
            }
          },
          "presentMarkerCount": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

