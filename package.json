{
  "name": "agent-compat-lab",
  "version": "0.1.0",
  "description": "Evidence-backed compatibility checks for coding-agent configuration surfaces.",
  "type": "module",
  "bin": {
    "agent-compat": "src/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "validate": "node scripts/validate-registry.js",
    "check": "node scripts/validate-registry.js && node --test",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "coding-agents",
    "codex",
    "claude-code",
    "github-copilot",
    "compatibility",
    "conformance",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asfdfdd/agent-compat-lab.git"
  },
  "bugs": {
    "url": "https://github.com/asfdfdd/agent-compat-lab/issues"
  },
  "homepage": "https://github.com/asfdfdd/agent-compat-lab#readme"
}
